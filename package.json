{
  "name": "dsh-umamusume-agent",
  "version": "0.1.2",
  "description": "Umamusume roleplay using the local Python runtime and your Harness model provider",
  "type": "module",
  "license": "MIT",
  "main": "harness/index.js",
  "exports": {
    ".": "./harness/index.js",
    "./preset": "./harness/preset.js",
    "./client": "./harness/client.js"
  },
  "files": [
    "harness/*.js",
    "harness/*.yml",
    "harness/requirements.txt",
    "src/umamusume_agent/**/*.py",
    "characters/*/config.json",
    "umamusume_characters.json",
    "docs/harness.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "typecheck": "tsc -p harness/tsconfig.json",
    "build": "node harness/scripts/build.js",
    "check:build": "node harness/scripts/build.js --check",
    "python:export": "node harness/scripts/export-python.js",
    "check:python-lock": "node harness/scripts/export-python.js --check",
    "test:runtime": "node harness/tests/locked-runtime.js",
    "test:package": "node harness/scripts/test-package.js",
    "test": "node --test harness/tests/*.test.js",
    "check:package": "node harness/scripts/check-package.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./harness/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-trajectory",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-trajectory": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
